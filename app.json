{
  "id": "se.warting.nfctools",
  "sdk": 3,
  "version": "2.0.0",
  "compatibility": ">=5.0.0",
  "platforms": ["local"],
  "name": {
    "en": "NFC tools"
  },
  "description": {
    "en": "NFC tools"
  },
  "category": ["tools"],
  "permissions": ["homey:wireless:nfc"],
  "brandColor": "#FF0000",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "Stefan Wärting",
    "email": "stefan@warting.se"
  },
  "contributors": {
    "developers": [
      {
        "name": "Stefan Wärting",
        "email": "stefan@warting.se"
      },
      {
        "name": "Jimmy Wärting",
        "email": "jimmy@warting.se"
      }
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "warting"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/warting/nfc-tools/issues"
  },
  "api": {
    "play": {
      "method": "POST",
      "path": "/play"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "nfc_touched",
        "title": {
          "en": "NFC touched"
        },
        "tokens": [
          {
            "name": "data",
            "type": "string",
            "title": {
              "en": "Data"
            },
            "example": "https://www.youtube.com/watch?v=vFFDArGuLBg"
          },
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title"
            },
            "example": "Movie title"
          },
          {
            "name": "id",
            "type": "string",
            "title": {
              "en": "Id"
            },
            "example": "aa:bb:cc:dd"
          },
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Count"
            },
            "example": 123
          }
        ]
      }
    ]
  }
}
